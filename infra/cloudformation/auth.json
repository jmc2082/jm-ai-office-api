{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "JM Office: Cognito user pool (single admin-created user) and a public app client for the Vue SPA. Writes the pool and client IDs to SSM so the API container picks them up.",
  "Parameters": {
    "ParamPath": {
      "Type": "String",
      "Default": "/jm-office/prod/app",
      "Description": "SSM path whose parameters become the API container's environment"
    }
  },
  "Resources": {
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "UserPoolName": "jm-office",
        "DeletionProtection": "ACTIVE",
        "UsernameAttributes": ["email"],
        "AutoVerifiedAttributes": ["email"],
        "AdminCreateUserConfig": { "AllowAdminCreateUserOnly": true },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [{ "Name": "verified_email", "Priority": 1 }]
        },
        "MfaConfiguration": "OPTIONAL",
        "EnabledMfas": ["SOFTWARE_TOKEN_MFA"],
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 14,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": false,
            "TemporaryPasswordValidityDays": 3
          }
        },
        "UserPoolTags": { "Project": "jm-office" }
      }
    },
    "WebClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": { "Ref": "UserPool" },
        "ClientName": "jm-office-web",
        "GenerateSecret": false,
        "ExplicitAuthFlows": ["ALLOW_USER_SRP_AUTH", "ALLOW_REFRESH_TOKEN_AUTH"],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "AccessTokenValidity": 60,
        "IdTokenValidity": 60,
        "RefreshTokenValidity": 30,
        "TokenValidityUnits": {
          "AccessToken": "minutes",
          "IdToken": "minutes",
          "RefreshToken": "days"
        }
      }
    },
    "UserPoolIdParam": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": { "Fn::Sub": "${ParamPath}/COGNITO_USER_POOL_ID" },
        "Type": "String",
        "Value": { "Ref": "UserPool" },
        "Tags": { "Project": "jm-office" }
      }
    },
    "ClientIdParam": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": { "Fn::Sub": "${ParamPath}/COGNITO_CLIENT_ID" },
        "Type": "String",
        "Value": { "Ref": "WebClient" },
        "Tags": { "Project": "jm-office" }
      }
    }
  },
  "Outputs": {
    "UserPoolId": { "Value": { "Ref": "UserPool" } },
    "WebClientId": { "Value": { "Ref": "WebClient" } }
  }
}
