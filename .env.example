# Copy to .env for local development. Never commit .env.
# In production these come from SSM Parameter Store.

PORT=4100
DATABASE_PATH=./data/office.db
CORS_ORIGINS=http://localhost:5173
QUEUE_CONCURRENCY=2
SCHEDULER_ENABLED=true

# mock = canned responses, no API calls, no cost. live = real Anthropic calls.
AI_MODE=mock
# Required when AI_MODE=live. Use a dedicated key with a Console spend cap.
ANTHROPIC_API_KEY=

# Local dev only. Refused when NODE_ENV=production.
AUTH_DISABLED=true
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Inbox triage (Sift). Leave MAIL_TOKEN_KEY empty to disable mail entirely.
# Generate a key: openssl rand -base64 32   (SecureString in SSM for production)
MAIL_TOKEN_KEY=
# Must match the redirect URIs registered with Google and Microsoft (+ /gmail or /microsoft).
MAIL_OAUTH_REDIRECT_BASE=http://localhost:4100/api/mail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Your work tenant ID, or "organizations" for any work account.
MS_TENANT=organizations
# Comma-separated addresses or domains whose mail always needs you.
MAIL_VIP_SENDERS=
MAIL_DIGEST_HOUR_UTC=13
MAIL_LOOKBACK_HOURS=24
MAIL_MAX_PER_RUN=50
