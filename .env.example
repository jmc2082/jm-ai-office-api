# Copy to .env for local development. Never commit .env.
# In production these come from SSM Parameter Store.

PORT=4100
DATABASE_PATH=./data/office.db
CORS_ORIGINS=http://localhost:5173
QUEUE_CONCURRENCY=2
SCHEDULER_ENABLED=true

# mock = canned responses, no API calls, no cost. live = real Anthropic calls.
AI_MODE=mock
# Required when AI_MODE=live. Use a dedicated key with a Console spend cap.
ANTHROPIC_API_KEY=

# Local dev only. Refused when NODE_ENV=production.
AUTH_DISABLED=true
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
